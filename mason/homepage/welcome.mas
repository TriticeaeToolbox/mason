<%once>
    my $display_photo = defined our $T3_WELCOME_PHOTO && $T3_WELCOME_PHOTO ne '' ? "/static_content/img/$T3_WELCOME_PHOTO" : undef;
</%once>

% if (defined $display_photo) {

<header>
    <h1>
        Welcome to <% our $T3_INSTANCE_NAME %>
        <% defined(our $T3_INSTANCE_PRIVATE) ? ' [' . $T3_INSTANCE_PRIVATE . ']' : '' %>
    </h1>
</header>

% } else {

<h1 style="text-align: center;">
    Welcome to <% our $T3_INSTANCE_NAME %>
    <% defined(our $T3_INSTANCE_PRIVATE) ? ' [' . $T3_INSTANCE_PRIVATE . ']' : '' %> 
</h1>

% }


<style>
    header {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        height: 200px;
        width: 100%;
        background-image: 
            linear-gradient(
                rgba(255, 255, 255, 0.1),
                rgba(0, 0, 0, 0.7)
            ),
            url('<% $display_photo %>');
        background-size: cover;
        background-position: center;
        border-radius: 8px;
        padding: 10px;
    }

    header h1 {
        color: white;
        margin-bottom: 5px;
        font-size: 200%;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
        text-align: center;
    }
</style>